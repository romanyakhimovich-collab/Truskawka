# Copy to keystore.properties (git-ignored) and fill in to sign release builds.
# Create the upload key once, e.g.:
#   keytool -genkeypair -v -keystore truskawka-upload.jks -alias upload -keyalg RSA -keysize 4096 -validity 10000
# Keep the .jks file and passwords safe and backed up: Play needs the same upload key
# for every update (Play App Signing can reset a lost upload key, but it takes time).
storeFile=truskawka-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
